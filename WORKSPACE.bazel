hedron_compile_commands_setup_transitive_transitive_transitive()

# ── rules_cc (pin BEFORE grpc_deps to prevent override) ──────────────────────
http_archive(
    name = "rules_cc",
    urls = ["https://github.com/bazelbuild/rules_cc/releases/download/0.0.9/rules_cc-0.0.9.tar.gz"],
