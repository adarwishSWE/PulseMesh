# Use WORKSPACE, not Bzlmod
common --noenable_bzlmod

# C++20
build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

# Warnings (keep -Wextra off — external deps like protobuf trip on unused-parameter)
# -Wno-deprecated-enum-enum-conversion: upb enums in newer gcc
build --cxxopt=-Wall
build --cxxopt=-Wno-deprecated-enum-enum-conversion
build --host_cxxopt=-Wno-deprecated-enum-enum-conversion

# Faster builds
build --jobs=auto

# Show output on test failure
test --test_output=errors
